@inject IDashboardService DashboardService
@inject ITaskService TaskService
@inject NavigationManager Navigation

<section class="task-widget">
    <div class="task-widget__header">
        <div>
            <h2>Tasks</h2>

            @if (_widget is not null)
            {
                <p>
                    @_widget.CurrentDate.ToString("dd MMM yyyy")
                </p>
            }
        </div>

        <div class="task-widget__header-actions">
            <button type="button"
                    disabled="@_isBusy"
                    @onclick="NavigateToTasks">
                View all
            </button>

            <button type="button"
                    disabled="@_isBusy"
                    @onclick="NavigateToNewTask">
                Add task
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <p>Loading tasks...</p>
    }
    else if (_loadError is not null)
    {
        <div class="task-widget__error"
             role="alert">
            <p>@_loadError</p>

            <button type="button"
                    disabled="@_isBusy"
                    @onclick="LoadWidgetAsync">
                Try again
            </button>
        </div>
    }
    else if (_widget is not null)
    {
        @if (_actionStatus is not null)
        {
            <div class="task-widget__status" role="status">
                @_actionStatus
            </div>
        }

        @if (_actionError is not null)
        {
            <div class="task-widget__error"
                 role="alert">
                @_actionError
            </div>
        }

        @if (_widget.Overdue.Count == 0 &&
             _widget.Today.Count == 0)
        {
            <div class="task-widget__empty">
                <p>No overdue tasks and nothing due today.</p>

                <button type="button"
                        disabled="@_isBusy"
                        @onclick="NavigateToNewTask">
                    Add a task
                </button>
            </div>
        }
        else
        {
            @if (_widget.Overdue.Count > 0)
            {
                <div class="task-widget__group">
                    <h3>
                        Overdue
                        <span>
                            @_widget.Overdue.Count
                        </span>
                    </h3>

                    @foreach (var task in _widget.Overdue)
                    {
                        <TaskWidgetItem
                            Task="@task"
                            IsBusy="@_isBusy"
                            OnComplete="CompleteTaskAsync" />
                    }
                </div>
            }

            @if (_widget.Today.Count > 0)
            {
                <div class="task-widget__group">
                    <h3>
                        Today
                        <span>
                            @_widget.Today.Count
                        </span>
                    </h3>

                    @foreach (var task in _widget.Today)
                    {
                        <TaskWidgetItem
                            Task="@task"
                            IsBusy="@_isBusy"
                            OnComplete="CompleteTaskAsync" />
                    }
                </div>
            }
        }
    }
</section>

@code {
    [Parameter]
    public EventCallback OnXpChanged { get; set; }

    private DashboardTaskWidgetDto? _widget;

    private bool _isLoading = true;
    private bool _isBusy;

    private string? _loadError;
    private string? _actionError;
    private string? _actionStatus;

    protected override async Task OnInitializedAsync()
    {
        await LoadWidgetAsync();
    }

    private async Task LoadWidgetAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            _widget =
                await DashboardService.GetTaskWidgetAsync();
        }
        catch (CurrentUserUnavailableException)
        {
            _loadError =
                "The current user is unavailable.";
        }
        catch (Exception)
        {
            _loadError =
                "Something went wrong while loading tasks.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CompleteTaskAsync(
        TaskSummaryDto task)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _actionError = null;
        _actionStatus = null;

        try
        {
            TaskCompletionResultDto completion;

            try
            {
                completion = await TaskService.CompleteTaskAsync(
                    task.Id);
            }
            catch (ValidationException exception)
            {
                _actionError = exception.Message;
                return;
            }
            catch (ResourceNotFoundException)
            {
                _actionError =
                    "The task could not be found.";

                await TryRefreshWidgetAsync(
                    "The task could not be found, and the latest task data could not be reloaded. Please refresh the page.");
                return;
            }
            catch (Exception)
            {
                _actionError =
                    "Something went wrong while completing the task.";
                return;
            }

            _actionStatus = GetCompletionStatus(completion);

            await TryRefreshWidgetAsync(
                "The task was completed, but the latest task data could not be reloaded. Please refresh the page.");

            if (completion.XpAward?.AwardedXp > 0)
            {
                try
                {
                    await OnXpChanged.InvokeAsync();
                }
                catch (Exception)
                {
                }
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string GetCompletionStatus(TaskCompletionResultDto result)
    {
        if (!result.WasNewlyCompleted)
        {
            return "Task is already completed.";
        }

        if (result.XpAwardFailed)
        {
            return "Task completed, but XP could not be recorded.";
        }

        if (result.XpAward is null || result.XpAward.IsDuplicate)
        {
            return "Task completed.";
        }

        if (result.XpAward.AwardedXp == 0)
        {
            return "Task completed. Daily Quest XP cap already reached.";
        }

        return result.XpAward.IsCapConstrained
            ? $"Task completed. +{result.XpAward.AwardedXp:N0} XP — daily Quest XP cap reached."
            : $"Task completed. +{result.XpAward.AwardedXp:N0} XP.";
    }

    private async Task RefreshWidgetAsync()
    {
        _widget =
            await DashboardService.GetTaskWidgetAsync();
    }

    private async Task TryRefreshWidgetAsync(
        string refreshFailureMessage)
    {
        try
        {
            await RefreshWidgetAsync();
        }
        catch (Exception)
        {
            _actionError = refreshFailureMessage;
        }
    }

    private void NavigateToTasks()
    {
        Navigation.NavigateTo("/tasks");
    }

    private void NavigateToNewTask()
    {
        Navigation.NavigateTo("/tasks/new");
    }
}