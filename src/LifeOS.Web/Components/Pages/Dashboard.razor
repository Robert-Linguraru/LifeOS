@page "/"

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">
    <div class="dashboard-page__header">
        <h1>Dashboard</h1>
        <p>Your LifeOS at a glance.</p>
    </div>

    <div class="dashboard-grid">
        <TaskWidget OnXpChanged="RefreshXpWidgetAsync" />
        <HabitWidget OnXpChanged="RefreshXpWidgetAsync" />
        <XpWidget @ref="_xpWidget" />
    </div>
</div>

@code {
    private XpWidget? _xpWidget;

    private async Task RefreshXpWidgetAsync()
    {
        if (_xpWidget is not null)
        {
            await _xpWidget.RefreshAsync();
        }
    }
}
