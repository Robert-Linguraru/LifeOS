@page "/habits/new"
@page "/habits/{HabitId:guid}/edit"

@inject IHabitService HabitService
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>

<div class="task-editor habit-editor">
    <div class="task-editor__header">
        <div>
            <h1>@HeadingText</h1>
            <p>@DescriptionText</p>
        </div>

        <button type="button"
                class="secondary-button"
                disabled="@_isSaving"
                @onclick="NavigateToHabits">
            Cancel
        </button>
    </div>

    @if (_isLoading)
    {
        <p>Loading habit...</p>
    }
    else if (_loadError is not null)
    {
        <div class="error-message" role="alert">
            @_loadError
        </div>

        <button type="button"
                class="secondary-button"
                @onclick="NavigateToHabits">
            Back to habits
        </button>
    }
    else if (_isArchived)
    {
        <div class="error-message" role="alert">
            This habit is archived and read-only.
        </div>

        <button type="button"
                class="secondary-button"
                @onclick="NavigateToHabits">
            Back to habits
        </button>
    }
    else
    {
        <EditForm Model="_model"
                  OnValidSubmit="HandleValidSubmitAsync">
            <DataAnnotationsValidator />

            @if (_saveError is not null)
            {
                <div class="error-message" role="alert">
                    @_saveError
                </div>
            }

            <div class="form-field">
                <label for="habit-name">Name</label>

                <InputText id="habit-name"
                           class="form-control"
                           @bind-Value="_model.Name"
                           disabled="@_isSaving" />

                <ValidationMessage For="() => _model.Name" />
            </div>

            <div class="form-field">
                <label for="habit-description">Description</label>

                <InputTextArea id="habit-description"
                               class="form-control"
                               @bind-Value="_model.Description"
                               disabled="@_isSaving" />

                <ValidationMessage For="() => _model.Description" />
            </div>

            <div class="form-field">
                <label for="habit-frequency">Frequency</label>

                <InputSelect id="habit-frequency"
                             class="form-control"
                             @bind-Value="_model.Frequency"
                             disabled="true">
                    <option value="@HabitFrequency.Daily">Daily</option>
                </InputSelect>

                <ValidationMessage For="() => _model.Frequency" />
            </div>

            <div class="form-field">
                <label for="habit-target-type">Target type</label>

                <InputSelect id="habit-target-type"
                             TValue="HabitTargetType"
                             class="form-control"
                             Value="@_model.TargetType"
                             ValueChanged="HandleTargetTypeChanged"
                             ValueExpression="() => _model.TargetType"
                             disabled="@_isSaving">
                    <option value="@HabitTargetType.Binary">Binary</option>
                    <option value="@HabitTargetType.Quantity">Quantity</option>
                </InputSelect>

                <ValidationMessage For="() => _model.TargetType" />
            </div>

            @if (_model.TargetType == HabitTargetType.Quantity)
            {
                <div class="form-row">
                    <div class="form-field">
                        <label for="habit-target-quantity">
                            Target quantity
                        </label>

                        <InputNumber id="habit-target-quantity"
                                     class="form-control"
                                     @bind-Value="_model.TargetQuantity"
                                     step="0.01"
                                     disabled="@_isSaving" />

                        <ValidationMessage
                            For="() => _model.TargetQuantity" />
                    </div>

                    <div class="form-field">
                        <label for="habit-target-unit">Target unit</label>

                        <InputText id="habit-target-unit"
                                   class="form-control"
                                   @bind-Value="_model.TargetUnit"
                                   disabled="@_isSaving" />

                        <ValidationMessage For="() => _model.TargetUnit" />
                    </div>
                </div>
            }

            <div class="form-row">
                <div class="form-field">
                    <label for="habit-estimated-time">
                        Estimated time
                    </label>

                    <InputSelect id="habit-estimated-time"
                                 class="form-control"
                                 @bind-Value="_model.EstimatedTime"
                                 disabled="@_isSaving">
                        @foreach (var estimatedTime in
                            Enum.GetValues<EstimatedTime>())
                        {
                            <option value="@estimatedTime">
                                @GetEstimatedTimeLabel(estimatedTime)
                            </option>
                        }
                    </InputSelect>

                    <ValidationMessage
                        For="() => _model.EstimatedTime" />
                </div>

                <div class="form-field">
                    <label for="habit-friction">Friction level</label>

                    <InputSelect id="habit-friction"
                                 class="form-control"
                                 @bind-Value="_model.FrictionLevel"
                                 disabled="@_isSaving">
                        @foreach (var frictionLevel in
                            Enum.GetValues<FrictionLevel>())
                        {
                            <option value="@frictionLevel">
                                @frictionLevel
                            </option>
                        }
                    </InputSelect>

                    <ValidationMessage
                        For="() => _model.FrictionLevel" />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit"
                        class="primary-button"
                        disabled="@_isSaving">
                    @(_isSaving ? "Saving..." : SaveButtonText)
                </button>

                <button type="button"
                        class="secondary-button"
                        disabled="@_isSaving"
                        @onclick="NavigateToHabits">
                    Cancel
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public Guid? HabitId { get; set; }

    private HabitFormModel _model = new();
    private bool _isLoading;
    private bool _isSaving;
    private bool _isArchived;
    private string? _loadError;
    private string? _saveError;

    private bool IsEditMode => HabitId.HasValue;

    private string PageTitleText =>
        IsEditMode ? "Edit Habit" : "New Habit";

    private string HeadingText =>
        IsEditMode ? "Edit habit" : "Add habit";

    private string DescriptionText =>
        IsEditMode
            ? "Update the details for this habit."
            : "Add a habit to your LifeOS.";

    private string SaveButtonText =>
        IsEditMode ? "Save changes" : "Create habit";

    protected override async Task OnParametersSetAsync()
    {
        _loadError = null;
        _saveError = null;
        _isArchived = false;

        if (!IsEditMode)
        {
            _model = new HabitFormModel();
            _isLoading = false;
            return;
        }

        _isLoading = true;

        try
        {
            var habit = await HabitService.GetHabitByIdAsync(
                HabitId!.Value);

            _model = new HabitFormModel
            {
                Name = habit.Name,
                Description = habit.Description,
                Frequency = habit.Frequency,
                TargetType = habit.TargetType,
                TargetQuantity = habit.TargetQuantity,
                TargetUnit = habit.TargetUnit,
                EstimatedTime = habit.EstimatedTime,
                FrictionLevel = habit.FrictionLevel
            };

            _isArchived = !habit.IsActive;
        }
        catch (CurrentUserUnavailableException)
        {
            _loadError = "The current user is unavailable.";
        }
        catch (ResourceNotFoundException)
        {
            _loadError = "The habit could not be found.";
        }
        catch (Exception)
        {
            _loadError =
                "Something went wrong while loading the habit.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleValidSubmitAsync()
    {
        if (_isSaving || _isArchived)
        {
            return;
        }

        _saveError = null;
        _isSaving = true;

        try
        {
            if (IsEditMode)
            {
                await HabitService.UpdateHabitAsync(
                    HabitId!.Value,
                    ToUpdateDto());
            }
            else
            {
                await HabitService.CreateHabitAsync(
                    ToCreateDto());
            }

            Navigation.NavigateTo("/habits");
        }
        catch (ValidationException exception)
        {
            _saveError = exception.Message;
        }
        catch (CurrentUserUnavailableException)
        {
            _saveError = "The current user is unavailable.";
        }
        catch (ResourceNotFoundException)
        {
            _saveError = "The habit could not be found.";
        }
        catch (Exception)
        {
            _saveError =
                "Something went wrong while saving the habit.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private Task HandleTargetTypeChanged(
        HabitTargetType targetType)
    {
        _model.TargetType = targetType;

        if (targetType == HabitTargetType.Binary)
        {
            _model.TargetQuantity = null;
            _model.TargetUnit = null;
        }

        return Task.CompletedTask;
    }

    private CreateHabitDto ToCreateDto()
    {
        return new CreateHabitDto
        {
            Name = _model.Name,
            Description = _model.Description,
            Frequency = HabitFrequency.Daily,
            TargetType = _model.TargetType,
            TargetQuantity = _model.TargetQuantity,
            TargetUnit = _model.TargetUnit,
            EstimatedTime = _model.EstimatedTime,
            FrictionLevel = _model.FrictionLevel
        };
    }

    private UpdateHabitDto ToUpdateDto()
    {
        return new UpdateHabitDto
        {
            Name = _model.Name,
            Description = _model.Description,
            Frequency = HabitFrequency.Daily,
            TargetType = _model.TargetType,
            TargetQuantity = _model.TargetQuantity,
            TargetUnit = _model.TargetUnit,
            EstimatedTime = _model.EstimatedTime,
            FrictionLevel = _model.FrictionLevel
        };
    }

    private void NavigateToHabits()
    {
        Navigation.NavigateTo("/habits");
    }

    private static string GetEstimatedTimeLabel(
        EstimatedTime estimatedTime)
    {
        return estimatedTime switch
        {
            EstimatedTime.Under15Minutes =>
                "Under 15 minutes",

            EstimatedTime.Between15And30Minutes =>
                "15–30 minutes",

            EstimatedTime.Between30And60Minutes =>
                "30–60 minutes",

            EstimatedTime.Over60Minutes =>
                "Over 60 minutes",

            _ => estimatedTime.ToString()
        };
    }
}
